#: corporate/lib/registration.py
#, python-brace-format
msgid ""
"Your organization has no Zulip licenses remaining and can no longer accept "
"new users. Please [increase the number of licenses]({billing_page_link}) or "
"[deactivate inactive users]({deactivate_user_help_page_link}) to allow new "
"users to join."
msgstr ""
"Tvoja organizacija nema više nijednu Zulip licenciju i ne može primati nove "
"korisnike. [Povećaj broj licencija]({billing_page_link}) ili [deaktiviraj "
"neaktivne korisnike]({deactivate_user_help_page_link}) da bi se novi "
"korisnici mogli pridružiti."

#: corporate/lib/registration.py
#, python-brace-format
msgid ""
"Your organization has only one Zulip license remaining. You can [increase "
"the number of licenses]({billing_page_link}) or [deactivate inactive users]"
"({deactivate_user_help_page_link}) to allow more than one user to join."
msgstr ""
"Tvoja organizacija ima još samo jednu Zulip licenciju. Možeš [povećati broj "
"licencija]({billing_page_link}) ili [deaktivirati neaktivne korisnike]("
"{deactivate_user_help_page_link}) da bi se moglo pridružiti više od jednog "
"korisnika."

#: corporate/lib/registration.py
#, python-brace-format
msgid ""
"Your organization has only two Zulip licenses remaining. You can [increase "
"the number of licenses]({billing_page_link}) or [deactivate inactive users]"
"({deactivate_user_help_page_link}) to allow more than two users to join."
msgstr ""
"Tvoja organizacija ima još samo dvije Zulip licencije. Možeš [povećati broj "
"licencija]({billing_page_link}) ili [deaktivirati neaktivne korisnike]("
"{deactivate_user_help_page_link}) da bi se moglo pridružiti više od dva "
"korisnika."

#: corporate/lib/registration.py
#, python-brace-format
msgid ""
"Your organization has only three Zulip licenses remaining. You can [increase "
"the number of licenses]({billing_page_link}) or [deactivate inactive users]"
"({deactivate_user_help_page_link}) to allow more than three users to join."
msgstr ""
"Tvoja organizacija ima još samo tri Zulip licencije. Možeš [povećati broj "
"licencija]({billing_page_link}) ili [deaktivirati neaktivne korisnike]("
"{deactivate_user_help_page_link}) da bi se moglo pridružiti više od tri "
"korisnika."

#: corporate/lib/registration.py
#, python-brace-format
msgid ""
"A new user ({email}) was unable to join because your organization does not "
"have enough Zulip licenses. To allow new users to join, make sure that the "
"[number of licenses for the current and next billing period]"
"({billing_page_link}) is greater than the current number of users."
msgstr ""
"Novi korisnik ({email}) nije se mogao pridružiti jer tvoja organizacija nema "
"dovoljno Zulip licencija. Da bi se novi korisnici mogli pridružiti, pobrini "
"se da [broj licencija za trenutačno i sljedeće obračunsko razdoblje]("
"{billing_page_link}) bude veći od trenutačnog broja korisnika."

#: corporate/lib/registration.py
msgid ""
"Your organization does not have enough Zulip licenses. Invitations were not "
"sent."
msgstr ""
"Tvoja organizacija nema dovoljno Zulip licencija. Pozivnice nisu poslane."

#: corporate/lib/registration.py
msgid ""
"Your organization does not have enough Zulip licenses to change a guest "
"user's role."
msgstr ""
"Tvoja organizacija nema dovoljno Zulip licencija za promjenu uloge gosta."

#: corporate/lib/remote_billing_util.py
msgid "Registration is deactivated"
msgstr "Registracija je deaktivirana"

#: corporate/lib/remote_billing_util.py
msgid "Invalid remote server."
msgstr "Neispravan udaljeni poslužitelj."

#: corporate/lib/stripe.py
#, python-brace-format
msgid ""
"You must purchase licenses for all active users in your organization "
"(minimum {min_licenses})."
msgstr ""
"Moraš kupiti licencije za sve aktivne korisnike u svojoj organizaciji "
"(najmanje {min_licenses})."

#: corporate/lib/stripe.py
#, python-brace-format
msgid ""
"Invoices with more than {max_licenses} licenses can't be processed from this "
"page. To complete the upgrade, please contact {email}."
msgstr ""
"Računi s više od {max_licenses} licencija ne mogu se obraditi s ove "
"stranice. Za dovršetak nadogradnje obrati se na {email}."

#: corporate/lib/stripe.py
msgid "No payment method on file."
msgstr "Nema spremljenog načina plaćanja."

#: corporate/lib/stripe.py
#, python-brace-format
msgid "{brand} ending in {last4}"
msgstr "{brand} koji završava na {last4}"

#: corporate/lib/stripe.py
#, python-brace-format
msgid "Unknown payment method. Please contact {email}."
msgstr "Nepoznat način plaćanja. Obrati se na {email}."

#: corporate/lib/stripe.py
#, python-brace-format
msgid "Something went wrong. Please contact {email}."
msgstr "Nešto je pošlo po zlu. Obrati se na {email}."

#: corporate/lib/stripe.py
msgid "Something went wrong. Please reload the page."
msgstr "Nešto je pošlo po zlu. Ponovno učitaj stranicu."

#: corporate/lib/stripe.py
msgid "Something went wrong. Please wait a few seconds and try again."
msgstr "Nešto je pošlo po zlu. Pričekaj nekoliko sekundi i pokušaj ponovno."

#: corporate/lib/stripe.py
msgid "Please add a credit card before starting your free trial."
msgstr "Dodaj kreditnu karticu prije početka besplatnog probnog razdoblja."

#: corporate/lib/stripe.py
msgid "Please add a credit card to schedule upgrade."
msgstr "Dodaj kreditnu karticu za zakazivanje nadogradnje."

#: corporate/lib/stripe.py
msgid ""
"Unable to update the plan. The plan has been expired and replaced with a new "
"plan."
msgstr ""
"Plana nije moguće ažurirati. Plan je istekao i zamijenjen je novim planom."

#: corporate/lib/stripe.py
msgid "Unable to update the plan. The plan has ended."
msgstr "Plana nije moguće ažurirati. Plan je završio."

#: corporate/lib/stripe.py
msgid ""
"Cannot update licenses in the current billing period for free trial plan."
msgstr ""
"Nije moguće ažurirati licencije u trenutačnom obračunskom razdoblju za "
"besplatni probni plan."

#: corporate/lib/stripe.py
msgid ""
"Unable to update licenses manually. Your plan is on automatic license "
"management."
msgstr ""
"Licencije nije moguće ažurirati ručno. Tvoj plan ima automatsko upravljanje "
"licencijama."

#: corporate/lib/stripe.py
#, python-brace-format
msgid ""
"Your plan is already on {licenses} licenses in the current billing period."
msgstr ""
"Tvoj plan već ima {licenses} licencija u trenutačnom obračunskom razdoblju."

#: corporate/lib/stripe.py
msgid "You cannot decrease the licenses in the current billing period."
msgstr "Ne možeš smanjiti broj licencija u trenutačnom obračunskom razdoblju."

#: corporate/lib/stripe.py
msgid ""
"Cannot change the licenses for next billing cycle for a plan that is being "
"downgraded."
msgstr ""
"Nije moguće promijeniti licencije za sljedeće obračunsko razdoblje za plan "
"koji se snižava."

#: corporate/lib/stripe.py
#, python-brace-format
msgid ""
"Your plan is already scheduled to renew with {licenses_at_next_renewal} "
"licenses."
msgstr ""
"Tvoj je plan već zakazan za obnovu s {licenses_at_next_renewal} licencija."

#: corporate/lib/stripe.py
#, python-brace-format
msgid ""
"You’ve already purchased {licenses_at_next_renewal} licenses for the next "
"billing period."
msgstr ""
"Već si kupio {licenses_at_next_renewal} licencija za sljedeće obračunsko "
"razdoblje."

#: corporate/lib/stripe.py
msgid "Nothing to change."
msgstr "Nema što promijeniti."

#: corporate/lib/stripe.py
msgid "No customer for this organization!"
msgstr "Nema kupca za ovu organizaciju!"

#: corporate/lib/stripe.py
msgid "Session not found"
msgstr "Sesija nije pronađena"

#: corporate/lib/stripe.py
msgid "Payment intent not found"
msgstr "Namjera plaćanja nije pronađena"

#: corporate/lib/stripe.py
msgid "Pass stripe_session_id or stripe_invoice_id"
msgstr "Proslijedi stripe_session_id ili stripe_invoice_id"

#: corporate/lib/stripe.py
#, python-brace-format
msgid ""
"Your organization's request for sponsored hosting has been approved! You "
"have been upgraded to {plan_name}, free of charge. {emoji}\n"
"\n"
"If you could {begin_link}list Zulip as a sponsor on your website{end_link}, "
"we would really appreciate it!"
msgstr ""
"Zahtjev tvoje organizacije za sponzorirano hostanje je odobren! Nadograđeni "
"ste na {plan_name}, bez naplate. {emoji}\n"
"\n"
"Ako možeš {begin_link}navesti Zulip kao sponzora na svojoj web-stranici"
"{end_link}, bili bismo ti vrlo zahvalni!"

