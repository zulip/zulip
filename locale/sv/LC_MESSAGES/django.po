#: templates/corporate/billing/remote_realm_login_error_for_server_on_active_plan.html
#: templates/corporate/billing/remote_server_login_error_for_any_realm_on_active_plan.html
msgid "Plan management not available"
msgstr "Planhantering är inte tillgänglig"

#: templates/corporate/billing/remote_realm_login_error_for_server_on_active_plan.html
#, python-format
msgid ""
"Plan management is not available for this organization, because your Zulip "
"server is already on a %(server_plan_name)s plan, which covers all "
"organizations on this server. See the <b>Server-level billing</b> tab of the "
"<a href=\"https://zulip.com/help/self-hosted-billing#log-in-to-billing-"
"management\">log in instructions</a> to administer the plan for your Zulip "
"server."
msgstr ""
"Planhantering är inte tillgänglig för den här organisationen eftersom Zulip-"
"servern redan har planen %(server_plan_name)s, som omfattar alla "
"organisationer på servern. Hantera serverplanen via fliken <b>Fakturering på "
"servernivå</b> i <a href=\"https://zulip.com/help/self-hosted-billing#log-in-"
"to-billing-management\">inloggningsanvisningarna</a>."

#: templates/corporate/billing/remote_realm_login_error_for_server_on_active_plan.html
msgid ""
"To move the plan from the server to this organization, or for other "
"questions, <a href=\"mailto:{{ support_email }}\">contact support</a>."
msgstr ""
