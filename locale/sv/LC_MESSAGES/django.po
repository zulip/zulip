"Det gick inte att stämma av faktureringsdata mellan servern och "
"organisationen. Kontakta {support_email}"

#: corporate/views/remote_billing_page.py
msgid "User account doesn't exist yet."
msgstr "Användarkontot finns inte ännu."

#: corporate/views/remote_billing_page.py
msgid "You must accept the Terms of Service to proceed."
msgstr "Du måste acceptera användarvillkoren för att fortsätta."

#: corporate/views/remote_billing_page.py
msgid ""
"This zulip_org_id is not registered with Zulip's billing management system."
msgstr "Detta zulip_org_id är inte registrerat i Zulips faktureringssystem."

#: corporate/views/remote_billing_page.py
msgid "Invalid zulip_org_key for this zulip_org_id."
msgstr "Ogiltig zulip_org_key för detta zulip_org_id."

#: corporate/views/remote_billing_page.py
msgid "Your server registration has been deactivated."
msgstr "Din serverregistrering har inaktiverats."

