#: templates/zerver/portico_error_pages/remote_realm_server_mismatch_error.html
msgid "Error"
msgstr "Fel"

#: templates/404.html
msgid "Page not found (404)"
msgstr "Sidan hittades inte (404)"

#: templates/404.html templates/4xx.html
#, python-format
msgid ""
"If this error is unexpected, you can <a href=\"mailto:"
"%(support_email)s\">contact support</a>."
msgstr ""
"Om det här felet är oväntat kan du <a href=\"mailto:"
"%(support_email)s\">kontakta support</a>."

#: templates/4xx.html
msgid "Access forbidden (403)"
msgstr "Tillträde förbjuden (403)"

#: templates/4xx.html
msgid ""
"Your request could not be completed because your browser did not send the "
"credentials required to authenticate your access. To resolve this issue:"
msgstr ""
"Din begäran kunde inte slutföras eftersom din webbläsare inte skickade de "
"autentiseringsuppgifter som krävs för att verifiera din åtkomst. Så här "
"löser du problemet:"

#: templates/4xx.html
msgid "Make sure that your browser allows cookies for this site."
msgstr "Se till att din webbläsare tillåter cookies för denna webbplats."

#: templates/4xx.html
msgid ""
"Check for any browser privacy settings or extensions that block Referer "
"headers, and disable them for this site."
msgstr ""
"Kontrollera om det finns webbläsares sekretessinställningar eller tillägg "
"som blockerar referensrubriker och inaktivera dem för den här webbplatsen."

#: templates/4xx.html
msgid "Method not allowed (405)"
msgstr "Metod inte tillåten (405)"

#: templates/500.html zerver/actions/scheduled_messages.py zerver/middleware.py
#: zerver/tornado/views.py
msgid "Internal server error"
msgstr "Internt serverfel"

#: templates/500.html
msgid ""
"Something went wrong. Sorry about that! We're aware of the problem and are "
"working to fix it. Zulip will load automatically once it is working again."
msgstr ""
"Något gick fel. Förlåt för det! Vi är medvetna om problemet och arbetar på "
"att åtgärda det. Zulip kommer att laddas automatiskt när det fungerar igen."

#: templates/500.html
#, python-format
msgid ""
"Please check <a href=\"%(status_url)s\">Zulip Cloud status</a> for more "
"information, and <a href=\"mailto:%(support_email)s\">contact Zulip support</"
"a> with any questions."
msgstr ""
"Kontrollera <a href=\"%(status_url)s\">statusen för Zulip Cloud</a> för mer "
"information och <a href=\"mailto:%(support_email)s\">kontakta Zulips "
"support</a> om du har frågor."

#: templates/500.html
msgid ""
"Something went wrong. Sorry about that! Zulip will load automatically once "
"it is working again."
msgstr ""
"Något gick fel. Förlåt för det! Zulip kommer att laddas automatiskt när det "
"fungerar igen."

#: templates/500.html
#, python-format
msgid ""
"<a href=\"mailto:%(support_email)s\">Contact this server's administrators</"
"a> for support."
msgstr ""
"<a href=\"mailto:%(support_email)s\">Kontakta denna servers administratörer</"
"a> för support."

#: templates/500.html
#, python-format
msgid ""
"If you administer this server, you may want to check out the <a "
"href=\"%(troubleshooting_url)s\">Zulip server troubleshooting guide</a>."
msgstr ""
"Om du administrerar den här servern kanske du vill kolla in <a "
"href=\"%(troubleshooting_url)s\">Zulip serverfelsökningsguide</a>."

