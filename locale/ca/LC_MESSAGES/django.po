#: corporate/views/remote_billing_page.py
msgid "User account doesn't exist yet."
msgstr "El compte d'usuari encara no existeix."

#: corporate/views/remote_billing_page.py
msgid "You must accept the Terms of Service to proceed."
msgstr "Cal que accepteu les condicions del servei per continuar."

#: corporate/views/remote_billing_page.py
msgid ""
"This zulip_org_id is not registered with Zulip's billing management system."
msgstr ""
"Aquest zulip_org_id no està registrat al sistema de gestió de facturació de "
"Zulip."

#: corporate/views/remote_billing_page.py
msgid "Invalid zulip_org_key for this zulip_org_id."
msgstr "El zulip_org_key no és vàlid per a aquest zulip_org_id."

#: corporate/views/remote_billing_page.py
msgid "Your server registration has been deactivated."
msgstr "S'ha desactivat el registre del vostre servidor."

