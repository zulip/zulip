#: templates/500.html zerver/actions/scheduled_messages.py zerver/middleware.py
#: zerver/tornado/views.py
msgid "Internal server error"
msgstr "Error intern del servidor"

#: templates/500.html
msgid ""
"Something went wrong. Sorry about that! We're aware of the problem and are "
"working to fix it. Zulip will load automatically once it is working again."
msgstr ""
"Alguna cosa ha anat malament. Ho sentim! Sabem del problema i hi estem "
"treballant. Zulip es carregarà automàticament quan torni a funcionar."

#: templates/500.html
#, python-format
msgid ""
"Please check <a href=\"%(status_url)s\">Zulip Cloud status</a> for more "
"information, and <a href=\"mailto:%(support_email)s\">contact Zulip support</"
"a> with any questions."
msgstr ""
"Consulteu l'<a href=\"%(status_url)s\">estat de Zulip Cloud</a> per obtenir "
"més informació i <a href=\"mailto:%(support_email)s\">contacteu amb el "
"servei d'assistència de Zulip</a> si teniu cap pregunta."

#: templates/500.html
msgid ""
"Something went wrong. Sorry about that! Zulip will load automatically once "
"it is working again."
msgstr ""
"Alguna cosa ha anat malament. Ho sentim! Zulip es carregarà automàticament "
"quan torni a funcionar."

#: templates/500.html
#, python-format
msgid ""
"<a href=\"mailto:%(support_email)s\">Contact this server's administrators</"
"a> for support."
msgstr ""
"<a href=\"mailto:%(support_email)s\">Contacteu amb l'equip d'administració "
"d'aquest servidor</a> per obtenir assistència."

#: templates/500.html
#, python-format
msgid ""
"If you administer this server, you may want to check out the <a "
"href=\"%(troubleshooting_url)s\">Zulip server troubleshooting guide</a>."
msgstr ""
"Si administreu aquest servidor, potser us interessarà consultar la <a "
"href=\"%(troubleshooting_url)s\">guia de resolució de problemes del servidor "
"de Zulip</a>."

