{
  "uid": "zulip-slo",
  "title": "Zulip · SLI y SLO de mensajería",
  "description": "Disponibilidad de POST /messages y latencia de entrega en tiempo real, con sus SLO.",
  "tags": [
    "zulip",
    "slo"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Disponibilidad: POST /messages · SLO 99 % en 30 días",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "SLI · 15 min",
      "description": "Peticiones con código < 500 y distinto de 401, 403 y 429, sobre el total. Ventana de alertamiento.",
      "datasource": {
        "type": "prometheus",
        "uid": "managed-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "managed-prometheus"
          },
          "expr": "(sum(rate(zulip_http_requests_total{endpoint=\"send_message\", status!~\"5..|401|403|429\"}[15m])) / sum(rate(zulip_http_requests_total{endpoint=\"send_message\"}[15m]))) * 100",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
