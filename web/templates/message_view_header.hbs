{{#if stream_settings_link}}
<a class="message-header-stream-settings-button tippy-zulip-tooltip" data-tooltip-template-id="stream-details-tooltip-template" data-tippy-placement="bottom" href="{{stream_settings_link}}">
    {{> navbar_icon_and_title . }}
</a>
<template id="stream-details-tooltip-template">
    <div>
        <div>{{t "Go to channel settings" }}</div>
        {{#unless is_spectator}}
        <div class="tooltip-inner-content italic">
            {{t "This channel has {sub_count, plural, =0 {no subscribers} one {# subscriber} other {# subscribers}}." }}
        </div>
        {{/unless}}
    </div>
</template>
<span class="narrow_description rendered_markdown single-line-rendered-markdown">
    {{#if rendered_narrow_description}}
    {{rendered_markdown rendered_narrow_description}}
    {{else}}
    {{#if is_admin}}
    <a href="{{stream_settings_link}}">
        {{t "Add a description"}}
    </a>
    {{/if}}
    {{/if}}
</span>
{{else if is_direct_message}}
<div class="navbar_title message-header-dm-container">
    {{#if icon}}
    <i class="zulip-icon zulip-icon-{{icon}} navbar-icon" aria-hidden="true"></i>
    {{else if zulip_icon}}
    <i class="zulip-icon zulip-icon-{{zulip_icon}} navbar-icon" aria-hidden="true"></i>
    {{/if}}
    <div class="dm-header-recipients">
        {{#each dm_recipients}}
            <button type="button" class="dm-header-avatar-button tippy-zulip-tooltip" data-user-id="{{this.user_id}}" aria-label="{{this.full_name}}" data-tippy-content="{{this.full_name}}">
                <span class="dm-header-avatar-wrapper">
                    <img src="{{this.avatar_url}}" class="dm-header-avatar" alt="" />
                    <span class="dm-header-presence-dot {{this.status_color_class}}" title="{{this.status_text}}"></span>
                </span>
                {{#if ../is_1_to_1}}
                <span class="dm-header-recipient-name">{{this.full_name}}</span>
                {{/if}}
            </button>
        {{/each}}
    </div>
</div>
{{else}}
<span class="navbar_title">
    {{> navbar_icon_and_title . }}
</span>
{{#if description}}
    <span class="narrow_description rendered_markdown single-line-rendered-markdown">{{description}}
        {{#if link}}
        <a class="help_link_widget" href="{{link}}" target="_blank" rel="noopener noreferrer">
            <i class="fa fa-question-circle-o" aria-hidden="true"></i>
        </a>
        {{/if}}
    </span>
{{/if}}
{{/if}}

