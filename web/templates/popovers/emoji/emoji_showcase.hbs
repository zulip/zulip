{{#with emoji_dict}}
<div class="emoji-showcase">
    {{#if is_realm_emoji}}
    {{> ../../realm_emoji url=url custom_classes="emoji-preview" }}
    {{else}}
    <div class="emoji emoji-preview emoji-{{emoji_code}}"></div>
    {{/if}}
    <div class="emoji-canonical-name" title="{{name}}">{{name}}</div>
</div>
{{/with}}
