<div class="remove-preview-overlay">
    <span class="remove-preview-overlay-text">{{t "Remove link preview"}}</span>
</div>
<div class="remove-preview-container">
    <button
      class="remove-preview-button tippy-zulip-delayed-tooltip"
      type="button"
      data-preview-url="{{preview_url}}"
      data-tippy-content="{{t 'Remove link preview'}}"
      aria-label="{{t 'Remove link preview'}}">
        <i class="zulip-icon zulip-icon-close" aria-hidden="true"></i>
    </button>
</div>

