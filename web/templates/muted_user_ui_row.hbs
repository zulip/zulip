{{#with muted_user}}
<tr data-user-id="{{user_id}}" data-user-name="{{user_name}}" data-date-muted="{{date_muted_str}}">
    <td>{{#if is_placeholder_user}}<span class="loading-shimmer {{loading_shimmer_width_class}}"></span>{{else}}{{user_name}}{{/if}}</td>
    <td>{{date_muted_str}}</td>
    <td class="actions">
        {{#if can_unmute}}
        {{> ./components/action_button
          label=(t "Unmute")
          variant="subtle"
          intent="danger"
          custom_classes="settings-unmute-user"
          }}
        {{/if}}
    </td>
</tr>
{{/with}}
