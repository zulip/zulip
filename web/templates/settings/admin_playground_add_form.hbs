<div id="add-playground-form">
    <p>
        {{t "For example, to configure a code playground for code blocks tagged as Rust, you can set:" }}
    </p>
    <ul>
        <li>
            {{t "Language" }}: <span class="rendered_markdown"><code>Rust</code></span>
        </li>
        <li>
            {{t "Name" }}: <span class="rendered_markdown"><code>Rust playground</code></span>
        </li>
        <li>
            {{t "URL template" }}: <span class="rendered_markdown"><code>https://play.rust-lang.org/?code={code}</code></span>
        </li>
    </ul>
    <form class="admin-playground-form modal-form" id="add-playground-form-modal">
        <div class="input-group">
            <label for="playground_pygments_language" class="modal-field-label">{{t "Language" }}</label>
            <input type="text" id="playground_pygments_language" class="modal_text_input" name="pygments_language" autocomplete="off" placeholder="Rust" />
        </div>
        <div class="input-group">
            <label for="playground_name" class="modal-field-label">{{t "Name" }}</label>
            <input type="text" id="playground_name" class="modal_text_input" name="playground_name" autocomplete="off" placeholder="Rust playground" />
        </div>
        <div class="input-group">
            <label for="playground_url_template" class="modal-field-label">{{t "URL template" }}</label>
            <input type="text" id="playground_url_template" class="modal_text_input" name="url_template" placeholder="https://play.rust-lang.org/?code={code}" />
        </div>
    </form>
</div>
