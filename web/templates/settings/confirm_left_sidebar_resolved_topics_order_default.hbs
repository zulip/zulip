<p class="left-sidebar-resolved-topics-order-overrides-intro">{{t "These channels have a custom setting, so changing the default won't affect them." }}</p>
<p class="left-sidebar-resolved-topics-order-overrides-empty hide">{{t "All channels will follow your default." }}</p>
<div class="left-sidebar-resolved-topics-order-overrides">
    {{#each channels}}
        <div class="left-sidebar-resolved-topics-order-override" data-stream-id="{{stream_id}}">
            <span class="stream-privacy" style="color: {{stream_privacy_icon_color}}">
                {{> ../stream_privacy .}}
            </span>
            <span class="left-sidebar-resolved-topics-order-override-name">{{name}}</span>
            <span class="left-sidebar-resolved-topics-order-override-value">{{order_description}}</span>
            {{> ../components/action_button
              label=(t "Reset to default")
              icon="reset"
              variant="subtle"
              intent="neutral"
              custom_classes="reset-left-sidebar-resolved-topics-order"
              type="button"
              }}
        </div>
    {{/each}}
</div>
