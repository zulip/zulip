{{! Alert word in the settings page that can be removed }}
{{#with alert_word}}
<tr class="alert-word-item" data-word='{{word}}'>
    <td>
        <div class="alert_word_listing">
            <span class="value">{{word}}</span>
        </div>
    </td>
    <td class="follow-topic-cell">
        {{!-- No `id`/`for` pair here, since an alert word can be any
        phrase, including one containing spaces, which is not a valid
        `id`. The nested input is associated with the label anyway. --}}
        <label class="checkbox">
            <input class="alert-word-follow-topic" type="checkbox" {{#if automatically_follow_topics}} checked="checked" {{/if}} data-word="{{word}}" />
            <span class="rendered-checkbox"></span>
        </label>
    </td>
    <td>
        {{> ../components/icon_button
          icon="trash"
          intent="danger"
          custom_classes="delete remove-alert-word tippy-zulip-delayed-tooltip"
          data-tippy-content=(t "Delete")
          }}
    </td>
</tr>
{{/with}}
