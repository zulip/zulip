<div class="edit-notifications{{#if modified}} has-edit-history{{/if}}"></div>
{{#if modified}}
    {{#unless (eq msg/local_edit_timestamp undefined)}}
        <div class="message_edit_notice">
            {{> editing_notifications}}
        </div>
    {{else if edited}}
        <div class="message_edit_notice">
            <i class="message-edited-icon zulip-icon zulip-icon-message-edited"></i>
        </div>
    {{else}}
        <div class="message_edit_notice">
            <i class="message-moved-icon zulip-icon zulip-icon-message-moved"></i>
        </div>
    {{/unless}}
{{/if}}
